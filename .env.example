# Copiar a .env para desarrollo local. En DigitalOcean estos valores se cargan como variables cifradas (tipo SECRET).
AMBIENTE=local
POSTGRES_PASSWORD=solo-desarrollo
JWT_SECRETO=cambiar-en-cada-ambiente
TOKEN_SERVICIO=cambiar-en-cada-ambiente
TIMEOUT_PAGOS_S=10
PERIODO_BARRIDO_S=5
PERIODO_REPARACION_S=60
DB_POOL_MAX=20
PASARELA_MODO_COBRO=aprobar
PASARELA_MODO_REEMBOLSO=aplicar
MINUTOS_ALERTA_FINANZAS=30
